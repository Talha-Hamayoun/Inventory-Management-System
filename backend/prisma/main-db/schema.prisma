generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("MAIN_DATABASE_URL")
}

// ==================== ENUMS ====================

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UnitOfMeasure {
  PCS
  KG
  LITERS
  METERS
  BOXES
}

enum MovementType {
  IN
  OUT
  ADJUST
  TRANSFER
  RETURN
}

enum ReferenceType {
  PO
  ORDER
  MANUAL
  TRANSFER
  RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  RESERVED
  RELEASED
  FULFILLED
}

enum ReturnCondition {
  RESTOCKABLE
  DAMAGED
}

enum ReturnType {
  SALES_RETURN
  PURCHASE_RETURN
}

enum ReturnStatus {
  PENDING
  PROCESSED
  CANCELLED
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  COD
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
}

// ==================== USER & ROLE MANAGEMENT ====================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique // Admin, Inventory Manager, Viewer
  permissions Json // JSON array of permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([name])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  roleId    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id])

  // Relations
  purchaseOrdersCreated PurchaseOrder[]     @relation("PurchaseOrderCreator")
  salesOrdersCreated    SalesOrder[]        @relation("SalesOrderCreator")
  inventoryMovements    InventoryMovement[] @relation("MovementPerformedBy")
  returnsProcessed      ReturnOrder[]       @relation("ReturnProcessedBy")
  auditLogs             AuditLog[]          @relation("AuditLogUser")
  sessions              Session[]

  @@index([email])
  @@index([roleId])
  @@index([isActive])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ==================== PRODUCT MANAGEMENT ====================

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  parentId    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([name])
  @@index([parentId])
}

model Product {
  id            Int           @id @default(autoincrement())
  name          String
  description   String?
  sku           String?       @unique
  categoryId    Int?
  status        ProductStatus @default(ACTIVE)
  unitOfMeasure UnitOfMeasure @default(PCS)
  barcode       String?
  costPrice     Decimal?      @db.Decimal(12, 2)
  sellingPrice  Decimal?      @db.Decimal(12, 2)
  isDeleted     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

  // Relations
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  stockReservations  StockReservation[]
  returnItems        ReturnItem[]
  stockAlerts        StockAlert[]

  @@index([name])
  @@index([sku])
  @@index([categoryId])
  @@index([status])
  @@index([barcode])
}

// ==================== WAREHOUSE / LOCATION MANAGEMENT ====================

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  salesOrders        SalesOrder[]
  stockReservations  StockReservation[]
  stockAlerts        StockAlert[]
  returns            ReturnOrder[]

  // Transfer relations
  outgoingTransfers InventoryMovement[] @relation("TransferFromWarehouse")
  incomingTransfers InventoryMovement[] @relation("TransferToWarehouse")

  @@index([name])
  @@index([isActive])
}

// ==================== SUPPLIER MANAGEMENT ====================

model Supplier {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  code         String   @unique
  contactName  String?
  email        String?  @unique
  phone        String?
  address      String?
  city         String?
  country      String?
  paymentTerms String?
  leadTimeDays Int?
  notes        String?
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  returns        ReturnOrder[]

  @@index([name])
  @@index([code])
  @@index([email])
  @@index([isActive])
}

// ==================== INVENTORY / STOCK MANAGEMENT ====================

model InventoryItem {
  id                Int       @id @default(autoincrement())
  productId         Int
  warehouseId       Int
  availableQuantity Int       @default(0)
  reservedQuantity  Int       @default(0)
  damagedQuantity   Int       @default(0)
  minimumStockLevel Int       @default(0)
  maximumStockLevel Int?
  reorderPoint      Int?
  lastRestockedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@index([availableQuantity])
  @@index([reorderPoint])
}

model InventoryMovement {
  id            Int           @id @default(autoincrement())
  productId     Int
  warehouseId   Int
  type          MovementType
  quantity      Int
  referenceType ReferenceType
  referenceId   Int?
  performedBy   Int
  notes         String?
  createdAt     DateTime      @default(now())

  // For transfers
  fromWarehouseId Int?
  toWarehouseId   Int?

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  performedByUser User      @relation("MovementPerformedBy", fields: [performedBy], references: [id])

  fromWarehouse Warehouse? @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([referenceType])
  @@index([referenceId])
  @@index([createdAt])
}

// ==================== PURCHASE ORDER MANAGEMENT ====================

model PurchaseOrder {
  id                   Int                 @id @default(autoincrement())
  supplierId           Int
  warehouseId          Int
  status               PurchaseOrderStatus @default(DRAFT)
  expectedDeliveryDate DateTime?
  totalCost            Decimal             @default(0) @db.Decimal(14, 2)
  createdBy            Int
  isDeleted            Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  createdByUser User                @relation("PurchaseOrderCreator", fields: [createdBy], references: [id])
  items         PurchaseOrderItem[]
  returns       ReturnOrder[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id               Int     @id @default(autoincrement())
  purchaseOrderId  Int
  productId        Int
  orderedQuantity  Int
  receivedQuantity Int     @default(0)
  unitCost         Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

// ==================== SALES / ORDER STOCK HANDLING ====================

model StockReservation {
  id          Int               @id @default(autoincrement())
  orderId     Int
  productId   Int
  warehouseId Int
  quantity    Int
  status      ReservationStatus @default(RESERVED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([warehouseId])
  @@index([status])
}

// ==================== RETURNS MANAGEMENT ====================

model ReturnOrder {
  id           Int          @id @default(autoincrement())
  returnNumber String       @unique
  returnType   ReturnType
  status       ReturnStatus @default(PENDING)

  // For SALES_RETURN — customer returning items to us
  salesOrderId Int?
  customerId   Int?

  // For PURCHASE_RETURN — we returning items to supplier
  purchaseOrderId Int?
  supplierId      Int?

  warehouseId Int
  notes       String?
  processedBy Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesOrder    SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  processedByUser User         @relation("ReturnProcessedBy", fields: [processedBy], references: [id])
  items         ReturnItem[]

  @@index([returnType])
  @@index([status])
  @@index([salesOrderId])
  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([createdAt])
}

model ReturnItem {
  id            Int             @id @default(autoincrement())
  returnOrderId Int
  productId     Int
  quantity      Int
  condition     ReturnCondition
  // Prices snapshotted from original order at time of return creation
  unitPrice     Decimal         @db.Decimal(12, 2) // what customer paid (from SalesOrderItem.unitPrice)
  unitCost      Decimal?        @db.Decimal(12, 2) // what we paid supplier (from SalesOrderItem.unitCost or PurchaseOrderItem.unitCost)

  returnOrder ReturnOrder @relation(fields: [returnOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([returnOrderId])
  @@index([productId])
}

// ==================== CUSTOMERS ====================

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String
  address   String?
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrders SalesOrder[]

  @@index([name])
  @@index([phone])
  @@index([isActive])
}

// ==================== SALES ORDER MANAGEMENT ====================

model SalesOrder {
  id          Int              @id @default(autoincrement())
  orderNumber String           @unique
  customerId  Int
  warehouseId Int
  status        SalesOrderStatus @default(PENDING)
  notes         String?
  totalAmount   Decimal          @default(0) @db.Decimal(14, 2)
  paymentStatus PaymentStatus    @default(UNPAID)
  amountPaid    Decimal          @default(0) @db.Decimal(14, 2)
  paymentMethod PaymentMethod?
  isDeleted     Boolean          @default(false)
  createdBy     Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  customer      Customer         @relation(fields: [customerId], references: [id])
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  createdByUser User             @relation("SalesOrderCreator", fields: [createdBy], references: [id])
  items         SalesOrderItem[]
  returns       ReturnOrder[]

  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

model SalesOrderItem {
  id           Int      @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2) // selling price at time of order (may differ from product.sellingPrice)
  unitCost     Decimal? @db.Decimal(12, 2) // cost price snapshot at time of order (for P&L tracking)
  totalPrice   Decimal  @db.Decimal(14, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@index([productId])
}

// ==================== ALERTS & NOTIFICATIONS ====================

model StockAlert {
  id          Int       @id @default(autoincrement())
  productId   Int
  warehouseId Int
  alertType   AlertType
  threshold   Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId, alertType])
  @@index([productId])
  @@index([warehouseId])
  @@index([alertType])
  @@index([isActive])
}

// ==================== AUDIT LOGGING ====================

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String // CREATE, UPDATE, DELETE
  entityType String // Product, Inventory, PurchaseOrder, etc.
  entityId   Int
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId Int
  user   User @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}
